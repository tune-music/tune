{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "yandex-page",
  "description": "Минимальный доступ для страницы Яндекс Музыки и плагинов, работающих в ней",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://music.yandex.ru/*",
      "https://music.yandex.com/*",
      "https://music.yandex.by/*",
      "https://music.yandex.kz/*",
      "https://music.yandex.uz/*"
    ]
  },
  "permissions": [
    "allow-page-ready",
    "allow-page-track",
    "allow-page-scripts",
    "allow-open-manager",
    "allow-page-window",
    "allow-page-cookie",
    "allow-page-download",
    "allow-page-reveal-download",
    "allow-page-lyrics",
    "allow-page-spoof-save",
    "allow-page-spoof-remove",
    "allow-page-station-list",
    "allow-page-station-play-file",
    "allow-page-station-login-start",
    "allow-page-station-login-open",
    "allow-page-station-login-poll",
    "allow-page-station-logout",
    "allow-page-station-connect",
    "allow-page-station-disconnect",
    "allow-page-station-send",
    "allow-install-update",
    "allow-skip-update"
  ]
}
