{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "manager",
  "description": "Окно Tune: аддоны, каталог и настройки",
  "windows": ["manager"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-list-addons",
    "allow-set-addon-enabled",
    "allow-delete-addon",
    "allow-addon-settings",
    "allow-set-addon-setting",
    "allow-reset-addon-settings",
    "allow-catalog",
    "allow-install-from-catalog",
    "allow-install-from-url",
    "allow-install-upload",
    "allow-create-addon",
    "allow-read-addon-file",
    "allow-write-addon-file",
    "allow-open-folder",
    "allow-open-link",
    "allow-reload-status",
    "allow-reload-client",
    "allow-show-client",
    "allow-get-settings",
    "allow-app-info",
    "allow-set-settings"
  ]
}
